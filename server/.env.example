# Server environment (Bare-metal fallback; Docker Compose sets these itself)

# MongoDB connection string.
# - Local dev fallback (no Docker): MONGO_URI=mongodb://localhost:27017/recruit
# - MongoDB Atlas: MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/recruit
MONGO_URI=mongodb://localhost:27017/recruit

# JWT signing secret. CHANGE THIS in any non-local environment.
JWT_SECRET_KEY=dev-secret-change-me-in-prod

# Access-token lifetime in minutes (stateless JWT).
JWT_ACCESS_MINUTES=30

# Refresh-token lifetime in days (opaque, rotated, revocable).
REFRESH_TOKEN_EXPIRES_DAYS=7

# bcrypt cost factor.
BCRYPT_ROUNDS=12

# Flask dev mode (enables the reloader / pretty tracebacks).
FLASK_DEBUG=1

# Comma-separated origins allowed to call the API cross-origin. Defaults to the
# Vite dev server; the Docker Compose path is single-origin (proxy), so this
# only matters when running the Vite dev server directly.
CORS_ORIGINS=http://localhost:5173