# Root environment (Docker Compose interpolation only).
#
# Compose reads this file automatically and substitutes ${VAR} references in
# docker-compose.yml. It is NOT read by the Flask app — the server reads
# server/.env (bare-metal fallback) and server/config.py class defaults.
#
# Only JWT_SECRET_KEY is interpolated in the dev compose file. Compose's
# `environment:` block is injected as a real container env var, and those always
# win over any .env file, so putting MONGO_URI / FLASK_DEBUG here does nothing.
#
# Generate a real key once per machine:
#   openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-change-me-in-prod