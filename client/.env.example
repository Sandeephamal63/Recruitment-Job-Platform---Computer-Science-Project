# Client environment (Bare-metal fallback; Docker Compose sets VITE_PROXY_TARGET itself)

# Base URL for API requests. "/api" is relative, so the Vite dev proxy handles routing.
VITE_API_BASE_URL=/api

# Target for the Vite dev proxy (/api/* -> target). Docker Compose overrides this
# with http://server:5000 (compose service name); bare metal uses localhost.
VITE_PROXY_TARGET=http://localhost:5000